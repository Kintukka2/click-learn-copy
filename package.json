{
  "name": "steplight",
  "version": "0.1.0",
  "private": true,
  "description": "Steplight: record a business process once, publish documentation, interactive training and in-app guidance in every format and language.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:lib": "node scripts/build-lib.mjs",
    "build:studio": "vite build --config studio/vite.config.ts",
    "build": "npm run build:lib && npm run build:studio",
    "start": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "fixtures": "tsx scripts/make-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "docx": "^9.12.0",
    "express": "^4.22.3",
    "jszip": "^3.10.2",
    "nanoid": "^5.1.16",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
