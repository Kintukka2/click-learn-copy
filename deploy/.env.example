# Public address of Steplight (the path after the domain is the prefix it is served under)
STEPLIGHT_BASE_URL=https://examplewebsite.app/steplight
# Anyone with this key can edit projects in the Studio; learners never need it
STEPLIGHT_ACCESS_KEY=change-me-to-a-long-random-string
# Token of your Cloudflare Tunnel (Zero Trust → Networks → Tunnels → your tunnel → install connector)
TUNNEL_TOKEN=
# Optional: enables Claude for AI help answers and translating author-written text
ANTHROPIC_API_KEY=
